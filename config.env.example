# config.env: settings for the Grok Bot box restore kit. Copy to /workspace/restore/config.env (install.sh does this
# if it is missing) and fill in your own values. Sourced by bash: KEY="value", no spaces around "=".
# This file holds NO secrets. Never put tokens, auth keys, or passwords here.

# Tailscale node hostname this box should have (required for item 100-tailscale), e.g. "my-grokbot-box".
WANT_HOST=""

# Tailscale tailnet name as shown by `tailscale status --json | jq -r .CurrentTailnet.Name`
# (for a personal tailnet this is usually your login name, e.g. "you@example.com"). Required for 100-tailscale.
WANT_TAILNET=""

# Optional: MagicDNS suffix, e.g. "tail1234.ts.net". Empty = don't check.
WANT_SUFFIX=""

# Optional: expected Tailscale IPv4 of this node, e.g. "100.64.0.1". Empty = don't check.
# A mismatch is only reported (WARN / note), never treated as broken: re-registering a node changes its IP.
WANT_IP=""

# Optional: GitHub login that gh on this box should be signed in as (item 250-gh-auth). Empty = accept any signed-in
# account, and if no persistent gh login exists at all, the item just passes.
GH_USER=""

# Whether other devices on your tailnet can SSH into this box via Tailscale SSH: "on" (default) or "off".
TAILSCALE_SSH="on"

# Linux (OS) hostname of the box, kept by item 050-hostname (root files reset on a computer update). One lowercase DNS label
# (letters, digits, hyphens; no dots), e.g. "my-grokbot-box". Empty = not managed.
WANT_OS_HOSTNAME=""

# Tick of the Tailscale watchdog loop (item 150-tailscale-online), whole seconds, 30..600. Required: the watchdog refuses to
# start (and logs why) if this is missing or malformed.
WATCHDOG_INTERVAL=60
