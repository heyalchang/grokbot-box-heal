#!/usr/bin/env bash
# ts-watchdog (item 150-tailscale-online). One copy only (flock), a tick every WATCHDOG_INTERVAL seconds (config.env, required,
# 30..600). Missing/malformed setting -> logs why and exits 2.
#  - logs one line per tick to $WS/tailscale/logs/ts-watch.log: wall/uptime deltas, JUMP flag (wall gap >= interval + 30 s,
#    i.e. a pause of ~30 s or more), BackendState, Self.Online, and tailscaled's TCP sockets as
#    peer/q<Send-Q>/u<unacked>/b<backoff>/r<lastrcv ms>. No secrets.
#  - acts (runs `restore --now`) when a tailscaled socket is STUCK (unacked>0 and backoff>=3, or backoff>=2 and silent >=20 s;
#    socket-level, independent of the tick), or when tailscaled is down / Running with Online=false on 2 ticks in a row
#    (NeedsLogin, NeedsMachineAuth, and Stopped are ignored so an unauthenticated or deliberately downed node is left alone).
#    At most one action per MIN_GAP (60 s).
#  - cap: MAX_ACTIONS (6) failed actions or daemon restarts (when tailscaled was not Running) per rolling hour, tracked in
#    $WS/restore/state/ts-watchdog.fails (one epoch per line). A socket-abort action on a Running node that brings it back online
#    does not count: a box that freezes every 15 min and recovers every time keeps working; a crash-looping tailscaled hits the cap.
#    Past the cap it stops acting, writes $WS/restore/state/ts-watchdog.capped (removing ts-watchdog.fails; item 150's check then
#    fails -> runner/daily routine alert) and only logs. Re-arm: remove ts-watchdog.capped (no pkill or restart needed).
#  - kill switch: $HERE/DISABLED is checked every tick and before every action; the loop exits within one tick.
#    For an immediate stop also run: pkill -f items/150-tailscale-online/watchdog
#  - log: rotates at 5 MB to ts-watch.log.1 (max ~10 MB on disk; ~0.35 MB/day at a 60 s tick).
# Usage: watchdog | watchdog --running (exit 0 if a copy runs)
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
WS=${BOX_WORKSPACE:-/workspace}; HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
LOCK=$WS/restore/state/ts-watchdog.lock; OUT=$WS/tailscale/logs/ts-watch.log
CAPFLAG=$WS/restore/state/ts-watchdog.capped; FAILFILE=$WS/restore/state/ts-watchdog.fails
MIN_GAP=60 MAX_ACTIONS=6 MAX_LOG=5242880 JUMP_SLACK=30
if [ "${1:-}" = --running ]; then exec 9>>"$LOCK"; flock -n 9 && exit 1 || exit 0; fi
mkdir -p "$(dirname "$OUT")" "$WS/restore/state"
CONF=${RESTORE_CONFIG:-$WS/restore/config.env}
INT=$( [ -r "$CONF" ] && . "$CONF" >/dev/null 2>&1; echo "${WATCHDOG_INTERVAL:-}")
if ! [[ "$INT" =~ ^[0-9]+$ ]] || [ "$INT" -lt 30 ] || [ "$INT" -gt 600 ]; then
  echo "$(date '+%F %T %Z') FAIL: WATCHDOG_INTERVAL in $CONF is missing or not a whole number 30..600 (got '${INT}'); not starting" >>"$OUT"
  exit 2
fi
exec 9>>"$LOCK"; flock -n 9 || { echo "$(date '+%F %T %Z') second copy pid=$$ refused (lock held); exiting" >>"$OUT"; exit 0; }
export RESTORE_ACTIVE=1
TS=/usr/local/bin/tailscale
say() { echo "$(date '+%F %T %Z') $*" >>"$OUT"; }
up() { read -r u _ </proc/uptime; echo "${u%.*}"; }
pw=$(date +%s); pu=$(up); off=0; last_act=0
say "start pid=$$ interval=${INT}s jump>=$((INT + JUMP_SLACK))s min_gap=${MIN_GAP}s cap=${MAX_ACTIONS} failed/h"
while :; do
  sleep "$INT" 9>&-   # 9>&-: children must not inherit the lock fd
  [ -e "$HERE/DISABLED" ] && { say "DISABLED flag found; exiting"; exit 0; }
  w=$(date +%s); u=$(up); dw=$((w - pw)); du=$((u - pu)); pw=$w; pu=$u
  jump=ok; [ "$dw" -ge $((INT + JUMP_SLACK)) ] && jump=JUMP
  read -r st on <<<"$(timeout 10 sudo -n "$TS" status --json 2>/dev/null | jq -r '[.BackendState, (.Self.Online|tostring)] | join(" ")' 2>/dev/null)"
  pid=$(pgrep -xo tailscaled); socks=""; stuck=0
  if [ -n "$pid" ]; then
    socks=$(sudo -n ss -tnpiH state established 2>/dev/null | awk -v p="pid=$pid," '
      index($0, p) { peer = $4; q = $2; getline info; bo = 0; ua = 0; lr = 0
        if (match(info, /backoff:[0-9]+/)) bo = substr(info, RSTART + 8, RLENGTH - 8)
        if (match(info, /unacked:[0-9]+/)) ua = substr(info, RSTART + 8, RLENGTH - 8)
        if (match(info, /lastrcv:[0-9]+/)) lr = substr(info, RSTART + 8, RLENGTH - 8)
        printf "%s/q%s/u%s/b%s/r%s%s ", peer, q, ua, bo, lr, (ua > 0 && (bo >= 3 || (bo >= 2 && lr >= 20000))) ? "/STUCK" : "" }')
    case "$socks" in *STUCK*) stuck=1 ;; esac
  fi
  case "$st" in
    NeedsLogin|NeedsMachineAuth|Stopped) off=0 ;;
    Running) [ "$on" = true ] && off=0 || off=$((off + 1)) ;;
    *) off=$((off + 1)) ;;
  esac
  say "dwall=${dw}s dup=${du}s $jump state=${st:-?} online=${on:-?} tcp=[${socks% }]"
  why=""
  case "$st" in NeedsLogin|NeedsMachineAuth|Stopped) ;; *) [ "$stuck" = 1 ] && why="stuck socket" ;; esac
  if [ "$off" -ge 2 ]; then
    if [ "$st" = Running ]; then why="${why:+$why, }offline $((off * INT))s"
    else why="${why:+$why, }state=${st:-down} $((off * INT))s"; fi
  fi
  if [ -n "$why" ] && [ $((w - last_act)) -ge "$MIN_GAP" ]; then
    # rolling 1 h window of failed actions + daemon restarts in $FAILFILE (one epoch per line)
    keep=()
    if [ -r "$FAILFILE" ]; then
      while read -r t _; do
        case $t in ''|*[!0-9]*) ;; *) [ $((w - t)) -lt 3600 ] && keep+=("$t") ;; esac
      done <"$FAILFILE"
    fi
    if [ "${#keep[@]}" -ge "$MAX_ACTIONS" ] || [ -e "$CAPFLAG" ]; then
      if [ ! -e "$CAPFLAG" ]; then
        echo "${#keep[@]} failed/restart actions within 1h, last at $(date '+%F %T %Z')" >"$CAPFLAG"
        rm -f "$FAILFILE"
        say "CAP REACHED (${#keep[@]} failed/restart actions/h): NOT acting any more; NEEDS HUMAN. Remove $CAPFLAG to re-arm."
        printf '%s [ts-watchdog] NEEDS HUMAN: action cap reached (%s failed/restart/h); stopped acting (%s)\n' "$(date '+%F %T %Z')" "$MAX_ACTIONS" "$CAPFLAG" >>"$WS/restore/restore.log"
      fi
    elif [ ! -e "$HERE/DISABLED" ]; then
      last_act=$w
      RESTORE_CALLER=watchdog BOX_WORKSPACE=$WS "$HERE/restore" --now 9>&-; rc=$?
      if [ "$rc" -ne 0 ] || [ "$st" != Running ]; then
        keep+=("$w")
        printf '%s\n' "${keep[@]}" >"$FAILFILE.tmp" && mv -f "$FAILFILE.tmp" "$FAILFILE"
      elif [ "${#keep[@]}" -gt 0 ]; then
        printf '%s\n' "${keep[@]}" >"$FAILFILE.tmp" && mv -f "$FAILFILE.tmp" "$FAILFILE"
      else
        rm -f "$FAILFILE"
      fi
      if [ "$rc" -eq 0 ]; then
        say "ACTION ($why): restore --now rc=0, recovered (failed/restart actions in the last hour: ${#keep[@]}/$MAX_ACTIONS)"
      else
        say "ACTION ($why): restore --now rc=$rc, FAILED (${#keep[@]}/$MAX_ACTIONS failed/restart actions in the last hour)"
      fi
    fi
  fi
  pw=$(date +%s)   # measure the next gap from the end of this tick (a pause mid-tick is then counted once)
  [ "$(stat -c %s "$OUT" 2>/dev/null || echo 0)" -gt "$MAX_LOG" ] && mv -f "$OUT" "$OUT.1"
done
